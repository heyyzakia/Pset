/*In CodeLand, there are X colleges, and each college has Y students. A total of Z students participated in a coding competition.

Assuming all students were eligible to participate, determine whether at least 60% of the students participated.*/

#include <stdio.h>
int main() {
    int x,y,z;
    scanf("%d %d %d", &x, &y, &z);
    if(z >= x*y*0.60)
        printf("60% of students participated!");
    else
        printf("60% of students NOT participated!");
    return 0;
}
