/*In CodeLand, there are X colleges, and each college has Y students. A total of Z students participated in a coding competition.

Assuming all students were eligible to participate, determine whether at least 60% of the students participated.*/

#include <stdio.h>
int main() {
    int x,y,z;
    scanf("%d %d %d", &x, &y, &z);
    if(z >= x*y*0.60)
        printf("60% of students participated!");
    else
        printf("60% of students NOT participated!");
    return 0;
}

/*In GameLand, there are X teams, and each team has Y players. A total of Z players participated in a tournament.

Determine whether strictly less than 40% of all players participated in the tournament.*/

#include <stdio.h>
int main() {
    int x,y,z;
    scanf("%d %d %d", &x, &y, &z);
    if (z<x*y*0.40)
        printf("yes");
    else
        printf("no");
    return 0;
}

/*In SkillLand, there are X schools, and each school has Y students. A total of Z students passed the exam.

Determine whether the percentage of students who passed is between 35% and 75%, inclusive.*/

#include<stdio.h>
int main(){
    int x,y,z;
    scanf("%d %d %d", &x, &y, &z);
    if(x*y*0.35<=z && z<=x*y*0.75)
        printf("yes");
    else
        printf("no");
    return 0;
}
