/*A company follows this schedule:
- Monday to Friday: X hours per day.
- Saturday: If the total working hours from Monday to Friday are more than 40 hours, employees work for Y hours on Saturday. Otherwise, they work for Z hours.
- Sunday: Holiday.
Given X, Y, and Z, calculate the total working hours in one week.*/

#include <stdio.h>

int main() {
	int x, y, z, total; 
	scanf("%d %d %d", &x, &y, &z);
	total=5*x;
    if(total>40)
        total=5*x+y;
    else
        total=5*x+z;
	printf("%d", total);
    return 0;
}
