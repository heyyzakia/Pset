/*A company follows this work schedule:
- Monday to Wednesday: Employees work for X hours per day.
- Thursday and Friday: Employees work for Y hours per day.
- Saturday: Employees work for Z hours.
- Sunday: Holiday.
Given X, Y, and Z, calculate the total number of working hours in one week.

Input format:
Three integers X, Y, and Z in a single line.

Output format:
Print the total working hours in one week.*/

#include<stdio.h>
int main(){
int x,y,z,total;
scanf("%d %d %d", &x, &y, &z);
total = 3*x+2*y+z;
printf("%d", total);
return 0;
}

