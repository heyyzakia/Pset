Each pizza consists of 4 slices. There are N friends, and each friend needs exactly X slices.
Find the minimum number of pizzas they should order to satisfy their appetite.

#include <stdio.h>
int main() {
    int t, n, x, min, total_slices;
    scanf("%d", &t);
    while(t--) {
        scanf("%d %d", &n, &x);
        total_slices = n * x;
        min = total_slices / 4;
        if(total_slices % 4 != 0)  //Remember, each pizza has exactly 4 slices.If the remainder is zero, we don't need another pizza. If the remainder is not zero, we need one extra pizza.
            min++;
        printf("%d\n", min);
    }
    return 0;
}

